# --- required ---
TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token

# GMGN OpenAPI key — optional. Powers rich token data shown in cards (market cap,
# liquidity, holders, ...) and the optional GMGN scanner. Manual /watch ATH alerts
# still work without it.
# Get one at https://gmgn.ai/ai?chain=sol&tab=api_management  →  "Create API Key".
# SECURITY: never commit a real key — it is read only from this var, never logged.
# GMGN_API_KEY=replace-with-your-gmgn-openapi-key

# --- authorization (REQUIRED: set one of these) ---
# Comma-separated chat IDs allowed to use the bot. Recommended.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# OR explicitly opt in to an OPEN bot (anyone can control it). Startup FAILS if
# neither this nor TELEGRAM_ALLOWED_CHAT_IDS is set (fail-closed).
# ALLOW_OPEN_BOT=true

# --- alert delivery target (optional) ---
# Pre-seed a chat to receive alerts. Otherwise any authorized chat that sends /start subscribes.
# Must be an integer chat ID and, if TELEGRAM_ALLOWED_CHAT_IDS is set, included there.
# TELEGRAM_CHAT_ID=123456789

# --- webhook (optional; long polling is used if WEBHOOK_URL is unset) ---
# WEBHOOK_URL=https://example.com/telegram
# WEBHOOK_PORT=8080                            # integer 1..65535
# WEBHOOK_SECRET_TOKEN=some-long-random-string   # REQUIRED when WEBHOOK_URL is set
# ALLOW_INSECURE_WEBHOOK=true                     # opt out of the secret-token requirement (unsafe)

# --- tunables (defaults shown) ---
# DEFAULT_DRAWDOWN_THRESHOLD_PCT=50   # must be > RECOVERY_HYSTERESIS_PCT
# POLL_INTERVAL_MS=60000              # >= 1000
# ATH_WINDOW=all                      # 'all' or a positive candle count
# ATH_MAX_CANDLES=1000                # candles requested when ATH_WINDOW=all
# ALERT_COOLDOWN_MS=1800000           # 30 min
# RECOVERY_HYSTERESIS_PCT=5           # [0, 100)
# QUOTE=native                        # 'native' (SOL) or 'usd'
# CHART_INTERVAL=1_DAY                # 1_MINUTE 3_MINUTE 5_MINUTE 15_MINUTE 30_MINUTE
#                                     # 1_HOUR 2_HOUR 4_HOUR 8_HOUR 12_HOUR 1_DAY 1_WEEK 1_MONTH
#                                     # (friendly aliases like 1h, 15m, 1d also accepted)
# FETCH_ATTEMPTS=3                    # >= 1
# FETCH_BACKOFF_MS=500
# FETCH_TIMEOUT_MS=8000              # per-request Jupiter timeout (>= 1000)
# POLL_CONCURRENCY=4                  # parallel token fetches per poll cycle (>= 1)
# STALE_CANDLE_MULTIPLIER=3          # skip a token if its latest candle is older than N intervals (>= 1)
# STORE_PATH=./data/alerts.json       # must differ from SUBSCRIBERS_PATH
# SUBSCRIBERS_PATH=./data/subscribers.json

# NOTE: persistedAth is denominated in QUOTE. Changing QUOTE rebases each token's
# stored ATH to the new denomination on its next poll (no cross-quote corruption).

# --- optional GMGN drawdown scanner (OFF by default; needs GMGN_API_KEY above) ---
# /scan runs one GMGN screening cycle on demand. Set GMGN_SCANNER_ENABLED=true only if
# you also want an automatic timer. Scanner candidates are NOT added to /watch; ATH
# drawdown alerts are only for mints you manually add with /watch.
# GMGN_SCANNER_ENABLED=false
# GMGN_SCAN_INTERVAL_MS=300000         # scan cadence (>= 60000; default 5 min)
# GMGN_TOTAL_FEE_MIN_SOL=30            # min total trading fees in SOL
# GMGN_MARKET_CAP_MIN_USD=250000       # min market cap (USD)
# GMGN_DRAWDOWN_MIN_PCT=50             # min % down from ATH ([0, 100])
# GMGN_MIN_TOKEN_AGE_HOURS=4           # min token age
# GMGN_MAX_TOKEN_AGE_DAYS=14           # max token age (min must be < max)
# GMGN_SCAN_LIMIT=100                  # trending rows to pull per scan ([1, 100])
# GMGN_SCAN_CONCURRENCY=4              # parallel token screenings ([1, 32])
# GMGN_REQUEST_INTERVAL_MS=1000        # min spacing between GMGN HTTP attempts (429 protection)
# GMGN_429_COOLDOWN_MS=20000           # fallback cooldown after a GMGN 429 when Retry-After is absent
# GMGN_DEDUPE_MS=86400000              # don't re-alert the same mint within this window (24h)
# GMGN_SCREENED_PATH=./data/gmgn-screened.json   # dedupe store (gitignored)
# GMGN_BASE_URL=https://openapi.gmgn.ai          # override only for testing

# --- optional Zap In reminder scanner (OFF by default; shares GMGN_API_KEY above) ---
# The inverse of the drawdown scanner: it looks for tokens at a *fresh* ATH with bullish
# momentum and sends separate "Zap In Reminder" alerts. /zap runs one cycle on demand.
# Set ZAP_SCANNER_ENABLED=true to also run it on a timer. Its candidates are NOT added to
# /watch; ATH drawdown alerts remain manual-watch only.
# A token qualifies only when ALL hold: market cap >= min, price at a new ATH (drawdown
# within tolerance AND that high was just touched), a recent 5m candle >= the volume floor,
# a bullish 15m Supertrend, token age <= the ceiling, and no blocking security issue.
# ZAP_SCANNER_ENABLED=false
# ZAP_SCAN_INTERVAL_MS=300000          # scan cadence (>= 60000; default 5 min)
# ZAP_MARKET_CAP_MIN_USD=250000        # min market cap (USD)
# ZAP_ATH_TOLERANCE_PCT=3              # max % below ATH to still count as "at a new ATH" ([0,100])
# ZAP_VOLUME_MIN_5M_USD=25000          # min USD volume in the hottest recent 5m candle
# ZAP_SUPERTREND_PERIOD=10             # Supertrend ATR period on 15m candles (integer >= 1)
# ZAP_SUPERTREND_MULTIPLIER=3          # Supertrend ATR multiplier ((0, 100])
# ZAP_MAX_TOKEN_AGE_HOURS=48           # max token age (under 2 days by default)
# ZAP_SCAN_LIMIT=100                   # trending rows to pull per scan ([1, 100])
# ZAP_SCAN_CONCURRENCY=4               # parallel token screenings ([1, 32])
# ZAP_DEDUPE_MS=86400000               # don't re-alert the same mint within this window (24h)
# ZAP_SCREENED_PATH=./data/zap-screened.json     # dedupe store (gitignored)

# --- Meteora DLMM pool links (ON by default) ---
# Adds the token's top Meteora DLMM pools (by TVL) to every alert and card, each
# labeled "<token>/<quote> binStep/baseFee% | TVL : <value>".
# Public API, no key required; best-effort (failures never block an alert).
# METEORA_LINKS_ENABLED=true            # set false to omit Meteora links
# METEORA_MAX_POOLS=5                   # pool links shown per alert ([1, 10])
# METEORA_BASE_URL=https://dlmm.datapi.meteora.ag   # override only for testing
